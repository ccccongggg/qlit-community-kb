extends includes/layout.pug

block content
  #article-container.container
    .people-wrap
      .people-hero
        h2.people-hero__title 社群里的大佬们
        p.people-hero__sub 每个方向都有扛把子。点头像进详情，看 TA 做过的项目、title 和能力分布。
      .people-grid
        each p in ((site.data.people && site.data.people.list) || [])
          a.people-card(href=`/people/${p.slug}/`)
            img.people-card__avatar(src=p.avatar, alt=p.name)
            .people-card__name= p.name
            .people-card__role= p.role
            .people-card__tags
              each t in p.ptags
                span.people-tag= t
